# ─── MetaIntel Platform – Environment Configuration ──────────────────────────

# Application
APP_NAME="MetaIntel Platform"
APP_ENV=production
APP_KEY=                        # Generated: php artisan key:generate
APP_DEBUG=false
APP_URL=http://localhost
APP_VERSION=1.0.0

# Database (PostgreSQL + PostGIS)
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=metaintel
DB_USERNAME=metaintel
DB_PASSWORD=password123

# Redis (Queue + Cache)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=password123
QUEUE_CONNECTION=redis
CACHE_DRIVER=redis
SESSION_DRIVER=redis

# Storage (MinIO / S3)
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=metaintel-images
AWS_ENDPOINT=http://minio:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

# MinIO Console
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# Elasticsearch
ELASTICSEARCH_HOST=elasticsearch
ELASTICSEARCH_PORT=9200

# Python Microservices
METADATA_SERVICE_URL=http://metadata-service:8001
FORENSICS_SERVICE_URL=http://forensics-service:8002
GEOSPATIAL_SERVICE_URL=http://geospatial-service:8003

# Geocoding (choose provider)
GEOCODING_PROVIDER=nominatim              # nominatim (free) | mapbox | google
MAPBOX_TOKEN=                             # pk.eyJ1... (optional)
GOOGLE_MAPS_API_KEY=AIzaSyAOj2eH4_Zbr8bmBUa9jjwUmV3cTQScuuY # AIzaSy... (optional)
NOMINATIM_USER_AGENT=MetaIntel/1.0

# AI / GPU
ENABLE_GPU=false                          # Set true for CUDA acceleration

# Frontend
NEXT_PUBLIC_API_URL=http://localhost/api
NEXT_PUBLIC_MAPBOX_TOKEN=                 # For Mapbox map tiles (optional)

# Mail (for notifications)
MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=noreply@metaintel.local
MAIL_FROM_NAME="MetaIntel Platform"

# Horizon
HORIZON_PREFIX=metaintel_horizon:

# Security
SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1

# Logging
LOG_CHANNEL=stack
LOG_LEVEL=info

# ─── Video Processing (v2) ────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=500
MAX_BATCH_SIZE_MB=2048
VIDEO_MAX_FRAMES=48
VIDEO_FRAME_INTERVAL_S=15
FFPROBE_PATH=/usr/bin/ffprobe
FFMPEG_PATH=/usr/bin/ffmpeg
MEDIAINFO_PATH=/usr/bin/mediainfo
